# Copy to ~/.config/palate/palate.toml. No secrets live here, only env var names.
home = "~/.palate"

[chat]
provider = "ollama"
model = "qwen3:8b"
# provider = "openrouter"
# model = "qwen/qwen3-30b-a3b"
# api_key_env = "OPENROUTER_API_KEY"

[embed]
provider = "ollama"
model = "embeddinggemma"

[rerank]
provider = "cross_encoder"
model = "minilm"

[tmdb]
token_env = "TMDB_READ_TOKEN"

[trace]
payloads = "hashed"
