# Copy to ~/.config/palate/palate.toml. No secrets live here, only env var names.
home = "~/.palate"

[chat]
# Runs in this process on MPS. No daemon, no key, about 6 GB of weights.
provider = "transformers"
model = "qwen2.5-3b-instruct"
# provider = "ollama"
# model = "qwen3:8b"
# provider = "openrouter"
# model = "qwen/qwen3-30b-a3b"
# api_key_env = "OPENROUTER_API_KEY"

[embed]
provider = "ollama"
model = "embeddinggemma"

[rerank]
provider = "cross_encoder"
model = "minilm"
# model = "bge-m3"       # accurate and seconds slower, needs uv sync --extra local
# provider = "identity"  # no rerank at all, which is the control the eval measures against

[tmdb]
token_env = "TMDB_READ_TOKEN"

[agent]
max_turns = 8
max_tool_calls = 16
max_cost_usd = 0.10
max_wall_s = 90
# strict_grounding = false  # keep unsupported sentences instead of dropping them

[trace]
enabled = true
# hashed proves what was sent without copying your viewing history into a second
# file. full is what replay needs.
payloads = "hashed"
retain_days = 30
