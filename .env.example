# Copy to .env and fill in what you actually use. Values here never reach the repo.

# Default key name the chat adapter reads. Point chat.api_key_env somewhere else to override.
PALATE_CHAT_API_KEY=
PALATE_EMBED_API_KEY=

# Conventional names. Set chat.api_key_env to the one you use.
OPENROUTER_API_KEY=
HF_TOKEN=

# TMDB v4 read token, sent as a bearer header, never as a query parameter.
TMDB_READ_TOKEN=

# Data root. Defaults to ~/.palate.
# PALATE_HOME=

# 1 also sets HF_HUB_OFFLINE so a download raises instead of hanging.
# PALATE_OFFLINE=

# off | hashed | full
# PALATE_TRACE__PAYLOADS=hashed
