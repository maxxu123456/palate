{
  "note": "ndjson, tool calls whole on the final object, counts on done",
  "request": {
    "method": "POST",
    "path": "/api/chat",
    "json": {
      "model": "qwen3:8b",
      "messages": [{"role": "user", "content": "something slow and cold"}],
      "stream": true,
      "keep_alive": "10m",
      "options": {"temperature": 0.2, "num_ctx": 8192},
      "tools": [
        {
          "type": "function",
          "function": {
            "name": "search_films",
            "description": "Hybrid retrieval over the unwatched corpus.",
            "parameters": {
              "type": "object",
              "properties": {"query": {"type": "string"}},
              "required": ["query"]
            }
          }
        }
      ]
    }
  },
  "response": {
    "status": 200,
    "ndjson": [
      {"model": "qwen3:8b", "message": {"role": "assistant", "content": "Looking"}, "done": false},
      {"model": "qwen3:8b", "message": {"role": "assistant", "content": " now"}, "done": false},
      {
        "model": "qwen3:8b",
        "message": {
          "role": "assistant",
          "content": "",
          "tool_calls": [
            {"function": {"name": "search_films", "arguments": {"query": "slow and cold"}}}
          ]
        },
        "done": true,
        "done_reason": "stop",
        "prompt_eval_count": 388,
        "eval_count": 31
      }
    ]
  }
}
